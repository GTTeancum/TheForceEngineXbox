<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="8.00"
	Name="TheForceEngine_Xbox"
	ProjectGUID="{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}"
	RootNamespace="TheForceEngine_Xbox"
	Keyword="Win32Proj"
	>
	<Platforms>
		<Platform
			Name="Win32"
		/>
	</Platforms>
	<ToolFiles>
	</ToolFiles>
	<Configurations>
		<Configuration
			Name="Release|Win32"
			OutputDirectory="$(SolutionDir)build\xbox\release"
			IntermediateDirectory="$(SolutionDir)build\xbox\release\obj"
			ConfigurationType="1"
			CharacterSet="2"
			>
			<Tool Name="VCPreBuildEventTool" />
			<Tool Name="VCCustomBuildTool" />
			<Tool Name="VCXMLDataGeneratorTool" />
			<Tool Name="VCWebServiceProxyGeneratorTool" />
			<Tool Name="VCMIDLTool" />
			<Tool
				Name="VCCLCompilerTool"
				AdditionalOptions="/MT /GS-"
				Optimization="2"
				AdditionalIncludeDirectories="C:\XDK\xbox\include;C:\XDK\xbox\include\DirectX;."
				PreprocessorDefinitions="_XBOX;NDEBUG;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;WIN32;_ITERATOR_DEBUG_LEVEL=0;_HAS_ITERATOR_DEBUGGING=0;_SECURE_SCL=0"
				RuntimeLibrary="0"
				ExceptionHandling="1"
				UsePrecompiledHeader="0"
				ForcedIncludeFiles="xbox_compat.h"
				WarningLevel="2"
				DebugInformationFormat="0"
				CompileAs="2"
				DisableSpecificWarnings="4996;4244;4267;4305"
			/>
			<Tool Name="VCManagedResourceCompilerTool" />
			<Tool Name="VCResourceCompilerTool" />
			<Tool Name="VCPreLinkEventTool" />
			<Tool
				Name="VCLinkerTool"
				AdditionalDependencies="xboxkrnl.lib xapilib.lib d3d8-xbox.lib xgraphics.lib dsound.lib D3DX8.Lib xacteng.lib xnet.lib xonline.lib libcmt.lib libcpmt.lib oldnames.lib"
				AdditionalOptions="/FIXED:NO /FORCE:MULTIPLE"
				OutputFile="$(OutDir)\default.exe"
				AdditionalLibraryDirectories="C:\XDK\lib"
				IgnoreAllDefaultLibraries="true"
				IgnoreDefaultLibraryNames="kernel32.lib;kernel32"
				GenerateManifest="false"
				GenerateDebugInformation="false"
				FixedBaseAddress="2"
				SubSystem="2"
				EntryPointSymbol="main"
			/>
			<Tool Name="VCALinkTool" />
			<Tool Name="VCManifestTool" EmbedManifest="false" />
			<Tool Name="VCXDCMakeTool" />
			<Tool Name="VCBscMakeTool" />
			<Tool Name="VCFxCopTool" />
			<Tool Name="VCAppVerifierTool" />
			<Tool Name="VCWebDeploymentTool" />
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="python &quot;$(SolutionDir)patchxbe.py&quot; &quot;$(OutDir)\default.exe&quot; &quot;$(OutDir)\default.xbe&quot;"
				Description="Building XBE..."
			/>
		</Configuration>
		<!-- Debug config removed - use Release only -->
	</Configurations>
